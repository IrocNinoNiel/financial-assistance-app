generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id            Bytes         @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  role_id       Bytes         @db.Binary(16)
  first_name    String        @db.VarChar(255)
  middle_name   String?       @db.VarChar(255)
  last_name     String        @db.VarChar(255)
  username      String        @db.VarChar(255) @default("user")
  mobile_number String        @db.VarChar(15)
  email         String        @unique(map: "email") @db.VarChar(255)
  password      String        @db.VarChar(255)
  created_at    DateTime?     @default(now()) @db.Timestamp(0)
  updated_at    DateTime?     @default(now()) @db.Timestamp(0)
  created_by    Bytes?        @db.Binary(16)
  updated_by    Bytes?        @db.Binary(16)
  record_status Boolean?      @default(true)
  profile       String?       @db.VarChar(255)
  students      student[]

  sponsors  sponsorship[] @relation(name: "sponsorship_sponsor")      // Sponsorships where the user is a sponsor
  coordinators  sponsorship[] @relation(name: "sponsorship_coordinator")  // Sponsorships where the user is a coordinator
  
  role          role          @relation(fields: [role_id], references: [id])

  @@map("users")
}

model role {
  id            Bytes              @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  name          String             @unique(map: "name") @db.VarChar(100)
  description   String?            @db.Text
  created_at    DateTime?          @default(now()) @db.Timestamp(0)
  updated_at    DateTime?          @default(now()) @db.Timestamp(0)
  created_by    Bytes?             @db.Binary(16)
  updated_by    Bytes?             @db.Binary(16)
  record_status Boolean?           @default(true)
  permissions   modulePermission[]
  user          user[]

  @@map("roles")
}

model module {
  id            Bytes              @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  name          String
  parentModule  Int?
  sorter        Int
  record_status Boolean            @default(true)
  permissions   modulePermission[]
}

model modulePermission {
  id        Bytes   @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  role_id   Bytes   @db.Binary(16)
  module_id Bytes   @db.Binary(16)
  show      Boolean @default(false)
  edit      Boolean @default(false)
  save      Boolean @default(false)
  delete    Boolean @default(false)

  module module @relation(fields: [module_id], references: [id])
  role   role   @relation(fields: [role_id], references: [id])
}

model sibling {
  id                  Bytes                   @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  student_id          Bytes                   @db.Binary(16)
  sibling_name        String                  @db.VarChar(255)
  sibling_bdate       DateTime                @db.Date
  sibling_age         Int
  sibling_status      siblings_sibling_status
  living_with_parents Boolean
  own_house           Boolean
  created_at          DateTime?               @default(now()) @db.Timestamp(0)
  updated_at          DateTime?               @default(now()) @db.Timestamp(0)
  created_by          Bytes?                  @db.Binary(16)
  updated_by          Bytes?                  @db.Binary(16)
  record_status       Boolean?                @default(true)
  student             student                 @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "siblings_ibfk_1")

  @@index([student_id], map: "student_id")
  @@map("siblings")
}

model student {
  id                    Bytes     @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  user_id               Bytes     @db.Binary(16)
  first_name            String    @db.VarChar(255)
  middle_name           String?   @db.VarChar(255)
  last_name             String    @db.VarChar(255)
  extension_name        String?   @db.VarChar(255)
  sex                   String?   @db.VarChar(10)
  place_of_birth        String?   @db.VarChar(255)
  birthdate             DateTime? @db.Date
  height                Float?    @db.Float
  weight                Float?    @db.Float
  permanent_street      String?   @db.VarChar(255)
  permanent_brg_id      Int?      @db.Int
  permanent_citymun_id  Int?      @db.Int
  permanent_province_id Int?      @db.Int
  permanent_region_id   Int?      @db.Int
  permanent_zip_code    Int?      @db.Int
  permanent_country     String?   @default("Philippines") @db.VarChar(255)

  current_street      String? @db.VarChar(255)
  current_brg_id      Int?    @db.Int
  current_citymun_id  Int?    @db.Int
  current_province_id Int?    @db.Int
  current_region_id   Int?    @db.Int
  current_zip_code    Int?    @db.Int
  current_country     String? @default("Philippines") @db.VarChar(255)

  email                   String?  @unique(map: "email") @db.VarChar(255)
  mobile_number           String?  @db.VarChar(15)
  is_solo_parent          Boolean?
  is_child_of_solo_parent Boolean?
  is_indigenous_people    Boolean?
  indigenous_group        String?  @db.VarChar(255)
  is_sped                 Boolean?
  is_pwd                  Boolean?

  emergency_contact_name    String? @db.VarChar(255)
  emergency_contact_number  String? @db.VarChar(15)
  emergency_contact_name2   String? @db.VarChar(255)
  emergency_contact_number2 String? @db.VarChar(15)

  g12_academic_strand    String? @db.VarChar(255)
  g12_program_name       String? @db.VarChar(255)
  g12_award_honor        String? @db.VarChar(255)
  g12_organization       String? @db.VarChar(255)
  g12_year_of_graduation Int?    @db.Int
  g12_school_id          Bytes?  @db.Binary(16)

  college_program_name String? @db.VarChar(255)
  college_year_level   Int?
  college_award_honor  String? @db.VarChar(255)
  college_organization String? @db.VarChar(255)
  college_school_id    Bytes?  @db.Binary(16)

  father_last_name     String? @db.VarChar(255)
  father_first_name    String? @db.VarChar(255)
  father_middle_name   String? @db.VarChar(255)
  father_extension     String? @db.VarChar(255)
  father_occupation    String? @db.VarChar(255)
  father_income        Float?  @db.Float
  father_mobile_number String? @db.VarChar(15)

  mother_maiden_last_name   String? @db.VarChar(255)
  mother_maiden_first_name  String? @db.VarChar(255)
  mother_maiden_middle_name String? @db.VarChar(255)
  mother_maiden_extension   String? @db.VarChar(255)
  mother_occupation         String? @db.VarChar(255)
  mother_income             Float?  @db.Float
  mother_mobile_number      String? @db.VarChar(15)

  guardian_last_name     String? @db.VarChar(255)
  guardian_first_name    String? @db.VarChar(255)
  guardian_middle_name   String? @db.VarChar(255)
  guardian_extension     String? @db.VarChar(255)
  guardian_occupation    String? @db.VarChar(255)
  guardian_income        Float?  @db.Float
  guardian_mobile_number String? @db.VarChar(15)

  number_of_siblings Int?
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  updated_at         DateTime? @default(now()) @db.Timestamp(0)
  created_by         Bytes?    @db.Binary(16)
  updated_by         Bytes?    @db.Binary(16)
  record_status      Boolean?  @default(true)

  siblings sibling[]
  sponsorshipApplication sponsorshipApplication[]
  users    user       @relation(fields: [user_id], references: [id])

  permanent_barangay barangay? @relation("PermanentStudentAddress", fields: [permanent_brg_id], references: [id])
  permanent_citynum  citymun?  @relation("PermanentStudentAddress", fields: [permanent_citymun_id], references: [id])
  permanent_province province? @relation("PermanentStudentAddress", fields: [permanent_province_id], references: [id])
  permanent_region   region?   @relation("PermanentStudentAddress", fields: [permanent_region_id], references: [id])

  current_barangay barangay? @relation("CurrentStudentAddress", fields: [current_brg_id], references: [id])
  current_citynum  citymun?  @relation("CurrentStudentAddress", fields: [current_citymun_id], references: [id])
  current_province province? @relation("CurrentStudentAddress", fields: [current_province_id], references: [id])
  current_region   region?   @relation("CurrentStudentAddress", fields: [current_region_id], references: [id])

  g12_school     school? @relation("G12School", fields: [g12_school_id], references: [id])
  college_school school? @relation("CollegeSchool", fields: [college_school_id], references: [id])
  files         file[]

  @@index([user_id], map: "user_id")
  @@map("students")
}

model announcement {
  id                  Bytes                  @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  title               String                 @db.VarChar(255)
  content             String                 @db.Text
  target_municipality String?                @db.VarChar(255)
  created_at          DateTime?              @default(now()) @db.Timestamp(0)
  updated_at          DateTime?              @default(now()) @db.Timestamp(0)
  created_by          Bytes?                 @db.Binary(16)
  updated_by          Bytes?                 @db.Binary(16)
  record_status       Boolean?               @default(true)
  locations           announcementLocation[]
  @@map("announcements")
}

model announcementLocation {
  id              Bytes        @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  announcement_id Bytes        @db.Binary(16)
  municipality    String       @db.VarChar(255)
  announcement    announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  @@index([announcement_id], map: "announcement_id")
}

model region {
  id                      Int       @id @default(autoincrement())
  psgc_code               String?
  reg_desc                String?
  reg_code                String?
  PermanentStudentAddress student[] @relation("PermanentStudentAddress")
  CurrentStudentAddress   student[] @relation("CurrentStudentAddress")

  @@map("regions")
}

model province {
  id                      Int       @id @default(autoincrement())
  psgc_code               String?
  prov_desc               String?
  reg_code                String?
  prov_code               String?
  schools                 school[]
  PermanentStudentAddress student[] @relation("PermanentStudentAddress")
  CurrentStudentAddress   student[] @relation("CurrentStudentAddress")

  @@map("provinces")
}

model citymun {
  id                      Int       @id @default(autoincrement())
  psgc_code               String?
  citymun_desc            String?
  reg_desc                String?
  prov_code               String?
  citymun_code            String?
  schools                 school[]
  PermanentStudentAddress student[] @relation("PermanentStudentAddress")
  CurrentStudentAddress   student[] @relation("CurrentStudentAddress")

  @@map("citymuns")
}

model barangay {
  id                      Int       @id @default(autoincrement())
  brgy_code               String?
  brgy_desc               String?
  reg_code                String?
  prov_code               String?
  citymun_code            String?
  schools                 school[]
  PermanentStudentAddress student[] @relation("PermanentStudentAddress")
  CurrentStudentAddress   student[] @relation("CurrentStudentAddress")

  @@map("barangays")
}

model school {
  id            Bytes     @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  province_id   Int
  citymun_id    Int
  brgy_id       Int
  school_name   String
  school_type   String
  record_status Boolean   @default(true)
  created_at    DateTime?
  updated_at    DateTime?
  created_by    Bytes?    @db.Binary(16)
  updated_by    Bytes?    @db.Binary(16)

  // Relations
  province province @relation(fields: [province_id], references: [id])
  citymun  citymun  @relation(fields: [citymun_id], references: [id])
  brgy     barangay @relation(fields: [brgy_id], references: [id])

  G12School              student[]                @relation("G12School")
  CollegeSchool          student[]                @relation("CollegeSchool")
  sponsorshipSchool      sponsorshipSchool[]

  // Indexes (without map argument)
  @@index([province_id])
  @@index([citymun_id])
  @@index([brgy_id])

  @@map("schools")
}

model fileType {
  id         Bytes     @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  name       String    @unique
  created_at DateTime? @default(now())
  updated_at DateTime?
  created_by Bytes?    @db.Binary(16)
  updated_by Bytes?    @db.Binary(16)

  files file[]
  sponsorshipRequirements sponsorshipRequirement[]
}

model file {
  id            Bytes     @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  file_name     String
  path          String
  mime_type     String
  file_type_id  Bytes     @db.Binary(16)
  student_id    Bytes     @db.Binary(16)
  record_status Boolean   @default(true)
  fileType      fileType  @relation(fields: [file_type_id], references: [id], onDelete: Cascade)
  student       student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  created_at    DateTime? @default(now())
  updated_at    DateTime?
  created_by    Bytes?    @db.Binary(16)
  updated_by    Bytes?    @db.Binary(16)
}

model sponsorship {
  id               Bytes    @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  name             String
  sponsor_id       Bytes    @db.Binary(16)
  coordinator_id   Bytes    @db.Binary(16)
  academic_year_id Bytes    @db.Binary(16)
  duration_from    DateTime
  duration_to      DateTime
  batch_number     Int
  limit            Int
  slot             Int
  fund_allocation  Decimal
  status           String
  record_status    Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Bytes    @db.Binary(16)
  updated_by       Bytes    @db.Binary(16)

  requirements sponsorshipRequirement[]
  schools      sponsorshipSchool[]
  sponsorshipApplication sponsorshipApplication[]
  sponsor      user                     @relation(fields: [sponsor_id], references: [id], name: "sponsorship_sponsor")
  coordinator  user                     @relation(fields: [coordinator_id], references: [id], name: "sponsorship_coordinator")
  academicYear academicYear             @relation(fields: [academic_year_id], references: [id])

  @@map("sponsorships")
}

model academicYear {
  id                  Bytes    @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  academic_year_start Int
  academic_year_end   Int
  school_term         Int
  date_from           DateTime
  date_to             DateTime
  record_status       Boolean   @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Bytes    @db.Binary(16)
  updated_by          Bytes    @db.Binary(16)

  sponsorships sponsorship[]

  @@map("academicYears")
}

model sponsorshipSchool {
  sponsorship_id Bytes @db.Binary(16)
  school_id      Bytes @db.Binary(16)

  sponsorship sponsorship @relation(fields: [sponsorship_id], references: [id])
  school      school      @relation(fields: [school_id], references: [id])

  @@id([sponsorship_id, school_id])
  @@map("sponsorshipSchools")
}

model sponsorshipRequirement {
  sponsorship_id Bytes @db.Binary(16)
  file_type_id      Bytes @db.Binary(16)

  sponsorship sponsorship @relation(fields: [sponsorship_id], references: [id])
  fileType      fileType      @relation(fields: [file_type_id], references: [id])

  @@id([sponsorship_id, file_type_id])
  @@map("sponsorshipRequirements")
}

model sponsorshipApplication {
  id                 Bytes    @id @default(dbgenerated("(UUID_TO_BIN(UUID()))")) @db.Binary(16)
  student_id          Bytes @db.Binary(16)
  sponsorship_id      Bytes @db.Binary(16)
  application_stage   application_stage
  application_status  application_status
  remarks            String?
  record_status       Boolean   @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Bytes    @db.Binary(16)
  updated_by          Bytes    @db.Binary(16)

  student      student                     @relation(fields: [student_id], references: [id])
  sponsorship  sponsorship                     @relation(fields: [sponsorship_id], references: [id])

  @@map("sponsorshipapplications")
}


enum siblings_sibling_status {
  Single
  Married
  Widowed
  Divorced
}




enum application_stage {
  POOLING
  INTERVIEW_EXAM
  RANKING_SELECTION
  FINAL_SELECTION
}

enum application_status {
  // for pooling
  PENDING_POOLING
  INCOMPLETE_DOCUMENTS // add remarks
  COMPLETE

  // for interview stage
  PENDING_INTERVIEW_EXAM
  PASSED_INTERVIEW_EXAM
  FAILED_INTERVIEW_EXAM
  DENIED_INTERVIEW_EXAM

  // for ranking selection
  PENDING_RANKING_SELECTION
  RANKED

  // for final phase
  NOT_SELECTED
  PENDING_FINAL_SELECTION
  APPROVED

  // can be on use in multiple stage (pooling, final phase)
  REJECTED
}